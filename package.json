{
  "name": "dsh-amp-radio",
  "version": "2.0.2",
  "private": true,
  "description": "AMP Radio and the AMP Bar for DeepSeek Harness: internet radio with a live visualiser, plus every chat stat in one tidy bar you can put at the top of the chat or under the message box, with an on/off switch for each.",
  "author": "AMP",
  "keywords": [
    "audio",
    "mobile",
    "radio",
    "somafm",
    "stats",
    "status-bar",
    "streaming",
    "visualizer"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
