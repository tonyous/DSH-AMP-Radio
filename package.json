{
  "name": "dsh-radio",
  "version": "1.1.0",
  "private": true,
  "description": "Internet radio player with live visualizer, station search, and favourites for DeepSeek Harness.",
  "author": "AMP",
  "keywords": ["radio", "streaming", "audio", "visualizer", "somafm"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "manifest.json", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "license": "MIT"
}
